{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "installation",
  "projectType": "application",
  "sourceRoot": "installation",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "type:package"
  ],
  "targets": {
    "dependency-cruiser": {},
    "deprecate-code": {},
    "eslint": {},
    "format-code": {},
    "guard-code": {},
    "installed-skills": {
      "cache": false,
      "configurations": {
        "check": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts installed-skills check"
        },
        "force": {
          "command": "SKILLS_INSTALL_FORCE=1 NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts installed-skills write"
        },
        "write": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts installed-skills write"
        }
      },
      "defaultConfiguration": "check",
      "description": "Checks or restores the skills `skills-lock.json` declares. `check` lists the locked skills whose `SKILL.md` is absent, and is what `scripts/git/validate-session-skills.sh` runs; `write` restores them, and is what the root `postinstall` runs. Never cached: its result depends on what is on disk and, in `write`, on the network.",
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "repl": {},
    "spell-check": {},
    "start": {
      "cache": false,
      "configurations": {
        "dependencies": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts dependencies"
        },
        "environment-files": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts environment-files"
        },
        "remote-cache": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts remote-cache"
        },
        "session-branch-name": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts session-branch-name"
        },
        "session-worktree-name": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts session-worktree-name"
        },
        "setup": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts setup"
        },
        "shared-nx-cache": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts shared-nx-cache"
        },
        "shell-configuration": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts shell-configuration"
        },
        "software": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts software"
        },
        "update-reui-skill": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts update-reui-skill"
        },
        "upgrade-dependencies": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts upgrade-dependencies"
        }
      },
      "description": "Run one installation command by name: setup, shell-configuration, software, environment-files, dependencies, remote-cache, update-reui-skill, upgrade-dependencies, shared-nx-cache, session-branch-name, or session-worktree-name.",
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "vitest": {},
    "vscode-settings": {
      "cache": false,
      "configurations": {
        "check": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts vscode-settings check"
        },
        "write": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register installation/src/installation.main.ts vscode-settings write"
        }
      },
      "defaultConfiguration": "check",
      "description": "Merges `.vscode/settings.json` into the VS Code Machine settings under `/root/.vscode-server`, which persist across devcontainer rebuilds. Uncached because its result depends on a file outside the workspace, and not part of `setup` or any aggregate because only a devcontainer has that path. The devcontainer's `postCreateCommand` runs `write`.",
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "yaml-lint": {}
  }
}
