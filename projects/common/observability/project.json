{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["!testing"],
  "name": "observability",
  "namedInputs": {
    "default": [
      "!{projectRoot}/.cspell/**",
      "!{projectRoot}/.eslintcache/**",
      "!{projectRoot}/conformetry-templates/**",
      "!{projectRoot}/cspell.config.yaml",
      "{projectRoot}/**/*",
      "shared-globals",
      "testing-source"
    ],
    "testing-source": [
      "{workspaceRoot}/projects/common/testing/package.json",
      "{workspaceRoot}/projects/common/testing/src/**/*"
    ],
    "typescript-files": [
      "{projectRoot}/**/*.{ts,tsx,mts,cts}",
      "{projectRoot}/**/*.json",
      "{projectRoot}/tsconfig*.json",
      "shared-globals",
      "testing-source"
    ]
  },
  "projectType": "library",
  "sourceRoot": "projects/common/observability",
  "tags": [
    "framework:nestjs",
    "language:typescript",
    "name:observability",
    "type:package"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": [
          {
            "glob": "README.md",
            "input": "projects/common/observability",
            "output": "."
          }
        ],
        "main": "projects/common/observability/src/index.ts",
        "outputPath": "projects/common/observability/dist",
        "tsConfig": "projects/common/observability/tsconfig.build.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "build-projects": {},
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "spell-check": {},
    "test-code": {},
    "type-coverage": {
      "inputs": [
        "{projectRoot}/**/*.ts",
        "{projectRoot}/**/*.tsx",
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig.json",
        "shared-globals",
        "testing-source",
        {
          "externalDependencies": ["type-coverage", "typescript"]
        }
      ]
    },
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
