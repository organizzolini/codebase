{
  "dependencies": {
    "@codebase/observability": "workspace:*",
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nx/devkit": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@testing-library/react": "catalog:",
    "execa": "catalog:",
    "prompts": "catalog:",
    "react": "catalog:",
    "reflect-metadata": "catalog:",
    "tslib": "catalog:",
    "verdaccio": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@types/prompts": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./end-to-end": "./src/end-to-end.ts",
    "./file-system": "./src/file-system.ts",
    "./nestjs": "./src/nestjs.ts",
    "./react": "./src/react.ts",
    "./react/setup": "./src/react-setup.ts",
    "./setup": "./src/setup.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "src/index.ts",
  "name": "@codebase/testing",
  "private": true,
  "publishConfig": {
    "exports": {
      ".": {
        "default": "./dist/src/index.js",
        "types": "./dist/src/index.d.ts"
      },
      "./end-to-end": {
        "default": "./dist/src/end-to-end.js",
        "types": "./dist/src/end-to-end.d.ts"
      },
      "./file-system": {
        "default": "./dist/src/file-system.js",
        "types": "./dist/src/file-system.d.ts"
      },
      "./nestjs": {
        "default": "./dist/src/nestjs.js",
        "types": "./dist/src/nestjs.d.ts"
      },
      "./react": {
        "default": "./dist/src/react.js",
        "types": "./dist/src/react.d.ts"
      },
      "./react/setup": {
        "default": "./dist/src/react-setup.js",
        "types": "./dist/src/react-setup.d.ts"
      },
      "./setup": {
        "default": "./dist/src/setup.js",
        "types": "./dist/src/setup.d.ts"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts"
  },
  "type": "module",
  "typeCoverage": {
    "atLeast": 100,
    "ignoreCatch": true,
    "ignoreFiles": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "src/modules/route-render/route-render.utilities.tsx"
    ],
    "strict": true
  },
  "types": "src/index.ts",
  "version": "0.0.1"
}
