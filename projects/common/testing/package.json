{
  "dependencies": {
    "@codebase/observability": "workspace:*",
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nx/devkit": "catalog:",
    "reflect-metadata": "catalog:",
    "tslib": "catalog:",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./nestjs": "./src/nestjs.ts",
    "./setup": "./src/setup.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "src/index.ts",
  "name": "@codebase/testing",
  "private": true,
  "publishConfig": {
    "exports": {
      ".": {
        "default": "./dist/src/index.js",
        "types": "./dist/src/index.d.ts"
      },
      "./nestjs": {
        "default": "./dist/src/nestjs.js",
        "types": "./dist/src/nestjs.d.ts"
      },
      "./setup": {
        "default": "./dist/src/setup.js",
        "types": "./dist/src/setup.d.ts"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts"
  },
  "type": "module",
  "typeCoverage": {
    "atLeast": 100,
    "ignoreCatch": true,
    "ignoreFiles": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "strict": true
  },
  "types": "src/index.ts",
  "version": "0.0.1"
}
