{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "persistence",
  "projectType": "library",
  "sourceRoot": "projects/common/persistence",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-service-project",
    "language:typescript",
    "name:persistence",
    "type:package"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": [
          {
            "glob": "README.md",
            "input": "projects/common/persistence",
            "output": "."
          }
        ],
        "generatePackageJson": false,
        "main": "projects/common/persistence/src/index.ts",
        "outputPath": "projects/common/persistence/dist",
        "tsConfig": "projects/common/persistence/tsconfig.build.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "build-projects": {},
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "spell-check": {},
    "start": {
      "cache": false,
      "configurations": {
        "postgresql-export": {
          "command": "node --import @swc-node/register/esm-register src/persistence.main.ts postgresql-export {args}"
        },
        "postgresql-import": {
          "command": "node --import @swc-node/register/esm-register src/persistence.main.ts postgresql-import {args}"
        }
      },
      "description": "Run the database command line: postgresql-export or postgresql-import selected tables",
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register src/persistence.main.ts {args}",
        "cwd": "{projectRoot}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
