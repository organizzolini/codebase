{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "persistence",
  "projectType": "library",
  "sourceRoot": "projects/common/persistence",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-service-project",
    "language:typescript",
    "name:persistence",
    "type:package"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": [
          {
            "glob": "README.md",
            "input": "projects/common/persistence",
            "output": "."
          }
        ],
        "generatePackageJson": false,
        "main": "projects/common/persistence/src/index.ts",
        "outputPath": "projects/common/persistence/dist",
        "tsConfig": "projects/common/persistence/configuration/tsconfig.build.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "build-projects": {},
    "compose-config": {
      "cache": false,
      "description": "Validate this project's Docker Compose file (the local PostgreSQL service) without starting anything. Part of lint-code, so the Lint leg of continuous-integration.yml runs it. Requires docker compose. Creates the workspace-root .env from .env.default when it is missing (the documented bootstrap; .env is gitignored) and never touches an existing one. Uncached on purpose: the compose file reads the workspace-root .env (env_file), which is gitignored and so cannot be declared as an input, and a cached pass would replay after .env goes missing or changes.",
      "executor": "nx:run-commands",
      "options": {
        "command": "test -f .env || cp .env.default .env; docker compose -f {projectRoot}/infrastructure/docker/docker-compose.yml config -q",
        "cwd": "{workspaceRoot}"
      }
    },
    "dependency-cruiser": {},
    "deprecate-code": {},
    "eslint": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "postgres": {
      "configurations": {
        "down": {
          "command": "docker compose -f {projectRoot}/infrastructure/docker/docker-compose.yml down postgres"
        },
        "recreate": {
          "command": "docker compose -f {projectRoot}/infrastructure/docker/docker-compose.yml down -v postgres && docker compose -f {projectRoot}/infrastructure/docker/docker-compose.yml up -d postgres"
        },
        "up": {
          "command": "docker compose -f {projectRoot}/infrastructure/docker/docker-compose.yml up -d postgres"
        }
      },
      "defaultConfiguration": "up",
      "description": "Start, stop, or recreate the local PostgreSQL container, which the compose file under this project's infrastructure/docker defines (recreate removes the volume)",
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "prettier": {},
    "spell-check": {},
    "start": {
      "cache": false,
      "configurations": {
        "postgresql-erd": {
          "command": "SWC_NODE_PROJECT=configuration/tsconfig.json node --import @swc-node/register/esm-register src/persistence.main.ts postgresql-erd {args}"
        },
        "postgresql-export": {
          "command": "SWC_NODE_PROJECT=configuration/tsconfig.json node --import @swc-node/register/esm-register src/persistence.main.ts postgresql-export {args}"
        },
        "postgresql-import": {
          "command": "SWC_NODE_PROJECT=configuration/tsconfig.json node --import @swc-node/register/esm-register src/persistence.main.ts postgresql-import {args}"
        }
      },
      "description": "Run the database command line: postgresql-export, postgresql-import, postgresql-erd, or the render-tree-data, render-directed-acyclic-graph-data, and render-graph-data diagram commands",
      "executor": "nx:run-commands",
      "options": {
        "command": "SWC_NODE_PROJECT=configuration/tsconfig.json node --import @swc-node/register/esm-register src/persistence.main.ts {args}",
        "cwd": "{projectRoot}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "typeorm-migration-sql": {
      "cache": true,
      "configurations": {
        "check": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register projects/common/persistence/src/persistence.main.ts typeorm-migration-sql check"
        },
        "write": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register projects/common/persistence/src/persistence.main.ts typeorm-migration-sql write"
        }
      },
      "defaultConfiguration": "check",
      "description": "Extracts SQL from TypeORM migration files and reconciles sibling `-up.sql` and `-down.sql` outputs. `check` reports drift for CI; `write` updates generated SQL files.",
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/**/*.ts",
        "{workspaceRoot}/projects/**/migrations/*.ts",
        "shared-globals"
      ],
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "vitest": {},
    "yaml-lint": {}
  }
}
