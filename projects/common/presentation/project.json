{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "presentation",
  "projectType": "library",
  "sourceRoot": "projects/common/presentation/src",
  "tags": ["framework:react", "language:typescript", "type:package"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "options": {
        "generatePackageJson": false,
        "outputPath": "projects/common/presentation/dist"
      },
      "outputs": ["{options.outputPath}"]
    },
    "build-projects": {},
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "spell-check": {},
    "stylelint": {},
    "type-coverage": {
      "options": {
        "command": "type-coverage --detail > type-coverage-report.txt 2>&1 || (cat type-coverage-report.txt && exit 1)"
      }
    },
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
