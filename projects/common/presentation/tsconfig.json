{
  "compilerOptions": {
    "declaration": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "../../dist/out-tsc",
    "paths": {
      "@/*": ["./src/*"],
      "codebase/configuration/*": ["../../../configuration/*"],
      "eslint-plugin-better-max-params": [
        "../../../configuration/types/eslint-plugin-better-max-params/index.d.ts"
      ]
    },
    "types": ["node", "vite/client"]
  },
  "extends": "../../../configuration/tsconfig.json",
  "include": [
    "configuration/*.mts",
    "configuration/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
