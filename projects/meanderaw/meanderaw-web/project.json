{
  "name": "meanderaw-web",
  "projectType": "application",
  "sourceRoot": "projects/meanderaw/meanderaw-web/src",
  "tags": [
    "domain:meanderaw",
    "framework:react",
    "framework:tanstack-start",
    "generator:tanstack-application",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "build": {
      "description": "Build the application for production",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "codegen": {
      "configurations": {
        "check": {
          "command": "pnpm run codegen --check"
        }
      },
      "description": "Generate typed GraphQL operations",
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/codegen.ts",
        "{projectRoot}/src/graphql/operations/**/*.graphql",
        "{workspaceRoot}/projects/meanderaw/meanderaw-api/src/schema.gql"
      ],
      "options": {
        "command": "pnpm run codegen",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/src/graphql/generated/operations.ts"]
    },
    "codegen-watch": {
      "continuous": true,
      "dependsOn": ["meanderaw-api:await-health", "meanderaw-api:start"],
      "description": "Regenerate GraphQL artifacts when schema or operations change",
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run codegen:watch",
        "cwd": "{projectRoot}"
      }
    },
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "preview": {
      "dependsOn": ["build"],
      "description": "Serve the production build locally",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "{projectRoot}"
      }
    },
    "spell-check": {},
    "start": {
      "description": "Start the development server with hot reload",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite dev",
        "cwd": "{projectRoot}"
      }
    },
    "stylelint": {},
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
