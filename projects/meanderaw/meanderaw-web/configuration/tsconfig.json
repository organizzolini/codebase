{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "target": "ES2022",
    "types": ["node", "vite/client"]
  },
  "exclude": ["../dist", "../node_modules", "../output"],
  "extends": "../../../../configuration/tsconfig.json",
  "include": [
    "*.mts",
    "*.ts",
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "../testing/**/*.ts",
    "../testing/**/*.tsx"
  ]
}
