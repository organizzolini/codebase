{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "conformetry-cli",
  "projectType": "library",
  "sourceRoot": "projects/ic-suite/conformetry/conformetry-cli",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "layer:cli",
    "name:conformetry",
    "type:package"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --config configuration/vite.config.ts",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "build-projects": {},
    "codometer": {},
    "codometer-limit": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "end-to-end": {},
    "eslint": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "pack": {},
    "prettier": {},
    "spell-check": {},
    "start": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register projects/ic-suite/conformetry/conformetry-cli/src/conformetry-cli.main.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "SWC_NODE_PROJECT": "projects/ic-suite/conformetry/conformetry-cli/configuration/tsconfig.json"
        }
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "vitest": {},
    "yaml-lint": {}
  }
}
