{
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "codebase/configuration/*": ["../../../../projects/configuration/*"],
      "eslint-plugin-better-max-params": [
        "../../../../projects/configuration/types/eslint-plugin-better-max-params/index.d.ts"
      ]
    },
    "target": "esnext",
    "types": ["node", "vitest/globals"]
  },
  "exclude": [
    "dist",
    "examples/compiled",
    "examples/corpus",
    "node_modules",
    "output"
  ],
  "extends": "../../../../projects/configuration/tsconfig.json",
  "include": [
    "codependix.config.ts",
    "codometer.config.ts",
    "eslint.config.ts",
    "examples/**/*.ts",
    "testing/**/*.ts",
    "vitest.config.ts"
  ]
}
