{
  "author": "Jimmy Paolini",
  "bugs": {
    "url": "https://github.com/organizzolini/codebase/issues"
  },
  "dependencies": {
    "@coinagerie/configuration": "workspace:*",
    "@coinagerie/core": "workspace:*",
    "@nestjs/common": "catalog:ic-suite",
    "reflect-metadata": "catalog:"
  },
  "description": "Renders and parses the markdown and JSON glossaries and compares them with the vocabulary of a codebase",
  "devDependencies": {
    "@golevelup/ts-vitest": "catalog:",
    "@nestjs/testing": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "homepage": "https://github.com/organizzolini/codebase/tree/main/projects/ic-suite/coinagerie/coinagerie-output#readme",
  "keywords": [
    "coinagerie",
    "glossary",
    "rendering",
    "vocabulary"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "name": "@coinagerie/output",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/src/index.js",
    "registry": "https://registry.npmjs.org",
    "types": "./dist/src/index.d.ts"
  },
  "repository": {
    "directory": "projects/ic-suite/coinagerie/coinagerie-output",
    "type": "git",
    "url": "git+https://github.com/organizzolini/codebase.git"
  },
  "type": "module",
  "typeCoverage": {
    "atLeast": 100,
    "strict": true
  },
  "types": "src/index.ts",
  "version": "0.0.7"
}
