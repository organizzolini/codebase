# What the shared application Dockerfile needs of this project; docker-image.sh reads it.
PROJECT=caelundas-api
TARGET=node
ENTRY=caelundas-api.js
# The API reads its port from this variable; docker-image.sh finds the value in configuration/.env.default.
PORT_VARIABLE=CAELUNDAS_API_PORT
# Lightship's probe port, beside the application port.
EXTRA_PORTS=9000
# The GraphQL schema is written beside the root module at startup.
WRITABLE_PATHS=projects/caelundas/caelundas-api/src
