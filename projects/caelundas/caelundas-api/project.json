{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "caelundas-api",
  "projectType": "application",
  "sourceRoot": "projects/caelundas/caelundas-api",
  "tags": [
    "domain:caelundas",
    "framework:nestjs",
    "generator:nestjs-graphql-application",
    "language:graphql",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "await-health": {
      "options": {
        "url": "http://localhost:${CAELUNDAS_API_PORT:-6173}/graphql"
      }
    },
    "bundle": {
      "description": "Bundle the API and its workspace packages to dist/caelundas-api with a production-only node_modules, ready to run with node",
      "executor": "nx:run-commands",
      "inputs": [
        "^production",
        "{workspaceRoot}/configuration/typescript/rolldown.application.config.ts",
        "dependency-versions",
        "production"
      ],
      "options": {
        "command": "rolldown --config configuration/rolldown.config.ts",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/caelundas-api"]
    },
    "dependency-cruiser": {},
    "deprecate-code": {},
    "docker": {
      "cache": false,
      "configurations": {
        "build": {
          "env": {
            "DOCKER_OUTPUT": "--load"
          }
        },
        "push": {
          "env": {
            "DOCKER_OUTPUT": "--push"
          }
        }
      },
      "defaultConfiguration": "build",
      "description": "Build (`docker:build`, loaded into the local daemon) or build and push (`docker:push`, one `docker buildx build --push`) the caelundas-api image for linux/amd64 from the shared application.Dockerfile, tagged ghcr.io/organizzolini/caelundas-api:$IMAGE_TAG (default local). Set CAELUNDAS_API_IMAGE_CA_BUNDLE to a PEM file to trust a TLS-inspecting proxy during the build. Never cached: a Docker build has no file outputs Nx could restore, so a remote cache hit would skip building, and a push is a side effect; layer caching is BuildKit's job.",
      "executor": "nx:run-commands",
      "options": {
        "command": "sh infrastructure/docker/docker-image.sh {projectRoot}",
        "cwd": "{workspaceRoot}"
      }
    },
    "eslint": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "spell-check": {},
    "start": {
      "continuous": true,
      "description": "Start the CaelundasApi GraphQL API",
      "executor": "nx:run-commands",
      "options": {
        "command": "SWC_NODE_PROJECT=configuration/tsconfig.json node --import @swc-node/register/esm-register src/caelundas-api.ts",
        "cwd": "{projectRoot}"
      }
    },
    "stop": {
      "options": {
        "port": "${CAELUNDAS_API_PORT:-6173}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "vitest": {},
    "yaml-lint": {}
  }
}
