{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "caelundas-api",
  "projectType": "application",
  "sourceRoot": "projects/caelundas/caelundas-api",
  "tags": [
    "domain:caelundas",
    "framework:nestjs",
    "generator:nestjs-graphql-application",
    "language:graphql",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "await-health": {
      "options": {
        "url": "http://localhost:${CAELUNDAS_API_PORT:-6173}/graphql"
      }
    },
    "dependency-cruiser": {},
    "deprecate-code": {},
    "docker-build": {
      "cache": false,
      "description": "Build the caelundas-api production image for linux/amd64 from the workspace root, tagged with IMAGE_TAG (default local); set CAELUNDAS_API_IMAGE_CA_BUNDLE to a PEM file to trust a TLS-inspecting proxy during the build",
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build --platform linux/amd64 -f projects/caelundas/caelundas-api/configuration/Dockerfile${CAELUNDAS_API_IMAGE_CA_BUNDLE:+ --secret id=ca-bundle,src=$CAELUNDAS_API_IMAGE_CA_BUNDLE} -t ghcr.io/organizzolini/caelundas-api:${IMAGE_TAG:-local} .",
        "cwd": "{workspaceRoot}"
      }
    },
    "docker-push": {
      "cache": false,
      "dependsOn": ["docker-build"],
      "description": "Push the caelundas-api image tagged with IMAGE_TAG (default local) to GHCR",
      "executor": "nx:run-commands",
      "options": {
        "command": "docker push ghcr.io/organizzolini/caelundas-api:${IMAGE_TAG:-local}",
        "cwd": "{workspaceRoot}"
      }
    },
    "eslint": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "spell-check": {},
    "start": {
      "continuous": true,
      "description": "Start the CaelundasApi GraphQL API",
      "executor": "nx:run-commands",
      "options": {
        "command": "SWC_NODE_PROJECT=configuration/tsconfig.json node --import @swc-node/register/esm-register src/caelundas-api.ts",
        "cwd": "{projectRoot}"
      }
    },
    "stop": {
      "options": {
        "port": "${CAELUNDAS_API_PORT:-6173}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "vitest": {},
    "yaml-lint": {}
  }
}
