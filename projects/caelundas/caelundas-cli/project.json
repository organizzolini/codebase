{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "caelundas-cli",
  "projectType": "application",
  "sourceRoot": "projects/caelundas/caelundas-cli",
  "tags": [
    "domain:caelundas",
    "framework:nest-commander",
    "framework:nestjs",
    "framework:typeorm",
    "generator:nestjs-command-project",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": [
          {
            "glob": "README.md",
            "input": "projects/caelundas/caelundas-cli",
            "output": "."
          }
        ],
        "generatePackageJson": false,
        "main": "projects/caelundas/caelundas-cli/src/caelundas-cli.main.ts",
        "outputPath": "projects/caelundas/caelundas-cli/dist",
        "tsConfig": "projects/caelundas/caelundas-cli/tsconfig.build.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "build-projects": {},
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "download-ephemeris": {
      "cache": true,
      "description": "Download the Swiss Ephemeris data files to data/ephemeris/ (cached, so CI fetches them once per cache key). Runs its own entry point, which does not connect to Postgres.",
      "executor": "nx:run-commands",
      "inputs": [
        "!{projectRoot}/**/*.test.ts",
        "{projectRoot}/src/ephemeris-download-cli.*",
        "{projectRoot}/src/modules/ephemeris-download/**/*"
      ],
      "options": {
        "command": "node --import @swc-node/register/esm-register src/ephemeris-download-cli.main.ts ephemeris-download",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/data/ephemeris"]
    },
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "migration": {
      "options": {
        "module": "src/modules/database"
      }
    },
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "repl": {
      "cache": false,
      "description": "Start an interactive NestJS REPL for Caelundas services",
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register src/caelundas-cli.repl.ts",
        "cwd": "{projectRoot}"
      }
    },
    "spell-check": {},
    "sqlfluff-format": {},
    "sqlfluff-lint": {},
    "squawk": {},
    "start": {
      "cache": false,
      "configurations": {
        "caelundas": {
          "command": "node --import @swc-node/register/esm-register src/caelundas-cli.main.ts caelundas {args}"
        }
      },
      "defaultConfiguration": "caelundas",
      "description": "Start the Caelundas application",
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register src/caelundas-cli.main.ts caelundas {args}",
        "cwd": "{projectRoot}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "vitest": {
      "dependsOn": ["download-ephemeris"]
    },
    "yaml-lint": {}
  }
}
