# What the shared application Dockerfile needs of this project; docker-image.sh reads it.
PROJECT=caelundas-cli
TARGET=node
ENTRY="caelundas-cli.main.js caelundas"
# sweph compiles its native binding on install, which needs a toolchain.
BUILD_PACKAGES="g++ make python3"
REBUILT_PACKAGES=sweph
# The Swiss Ephemeris files are fetched at build time, so a run never downloads them.
PREPARE_COMMAND="NODE_USE_ENV_PROXY=1 node /workspace/dist/caelundas-cli/ephemeris-download-cli.main.js ephemeris-download"
RUNTIME_PATHS=data
# Node sizes its default heap from the container limit, about 760 MB under the Job's 1.5 GiB, which one year's
# events overrun when the calendar is written; 1 GiB leaves the rest for the native ephemeris and buffers.
RUNTIME_NODE_OPTIONS=--max-old-space-size=1024
