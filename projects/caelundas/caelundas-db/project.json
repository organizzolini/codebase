{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "caelundas-db",
  "projectType": "library",
  "sourceRoot": "projects/caelundas/caelundas-db",
  "tags": [
    "domain:caelundas",
    "framework:nestjs",
    "framework:typeorm",
    "language:typescript",
    "name:caelundas-db",
    "type:package"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": [
          {
            "glob": "README.md",
            "input": "projects/caelundas/caelundas-db",
            "output": "."
          }
        ],
        "generatePackageJson": false,
        "main": "projects/caelundas/caelundas-db/src/index.ts",
        "outputPath": "projects/caelundas/caelundas-db/dist",
        "tsConfig": "projects/caelundas/caelundas-db/configuration/tsconfig.build.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "build-projects": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "eslint": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "migration": {
      "options": {
        "module": "src/modules/caelundas-database"
      }
    },
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "render-tag-tree": {
      "cache": false,
      "description": "Draw the caelundas tag tree as a Mermaid flowchart from the local database; pass --args=\"--truncate-depth 2 --output-markdown tags.md\" for the filter, sort, depth, breadth, paging and output options",
      "executor": "nx:run-commands",
      "options": {
        "command": "SWC_NODE_PROJECT=projects/common/persistence/configuration/tsconfig.json node --import @swc-node/register/esm-register projects/common/persistence/src/persistence.main.ts render-tree-data --source-uri \"postgresql://${CAELUNDAS_POSTGRES_USERNAME:?set CAELUNDAS_POSTGRES_USERNAME}:${CAELUNDAS_POSTGRES_PASSWORD:?set CAELUNDAS_POSTGRES_PASSWORD}@${CAELUNDAS_POSTGRES_HOST:-localhost}:${CAELUNDAS_POSTGRES_PORT:-5432}/${CAELUNDAS_POSTGRES_DATABASE:?set CAELUNDAS_POSTGRES_DATABASE}\" --schema \"${CAELUNDAS_POSTGRES_SCHEMA:-caelundas}\" --entities 'projects/caelundas/caelundas-db/src/**/tag.entity.ts' --table tags {args}",
        "cwd": "{workspaceRoot}"
      }
    },
    "spell-check": {},
    "sqlfluff-format": {},
    "sqlfluff-lint": {},
    "squawk": {},
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "vitest": {},
    "yaml-lint": {}
  }
}
