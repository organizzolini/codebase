# What the shared application.Dockerfile needs of this project; docker-image.sh reads it.
PROJECT=caelundas-web
TARGET=static
BUILD_COMMAND="pnpm exec vite build --config configuration/vite.config.mts"
OUTPUT_PATH=dist/client
# Vite reads VITE_ variables when it builds, so the API address is baked into the JavaScript.
BUILD_ENVIRONMENT="VITE_CAELUNDAS_API_URL=${VITE_CAELUNDAS_API_URL:-https://caelundas.organizzolini.net/graphql}"
