{
  "name": "caelundas-web",
  "namedInputs": {
    "default": [
      "!{projectRoot}/.cspell/**",
      "!{projectRoot}/.eslintcache/**",
      "!{projectRoot}/conformetry-templates/**",
      "!{projectRoot}/cspell.config.yaml",
      "{projectRoot}/**/*",
      "{workspaceRoot}/projects/caelundas/caelundas-cli/data/*.sql",
      "{workspaceRoot}/projects/caelundas/caelundas-cli/src/modules/database/migrations/*.sql",
      "shared-globals"
    ]
  },
  "projectType": "application",
  "sourceRoot": "projects/caelundas/caelundas-web/src",
  "tags": [
    "domain:caelundas",
    "framework:react",
    "framework:tanstack-start",
    "generator:tanstack-application",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "build": {
      "configurations": {
        "ingested": {}
      },
      "dependsOn": ["build-database"],
      "description": "Build the application for production",
      "executor": "nx:run-commands",
      "inputs": [
        "^production",
        "dependency-versions",
        "production",
        {
          "dependentTasksOutputFiles": "**/events.sqlite"
        }
      ],
      "options": {
        "command": "vite build",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "build-database": {
      "cache": false,
      "configurations": {
        "ingested": {
          "command": "pnpm exec nx run caelundas-cli:events-database --args=\"--output=../caelundas-web/output/events.sqlite\""
        }
      },
      "description": "Write the SQLite file the static build bundles into output/, through caelundas-cli's events-database command: from the committed seed, or with the ingested configuration from the output/database.sqlite caelundas-cli wrote",
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx run caelundas-cli:events-database --args=\"--seed --output=../caelundas-web/output/events.sqlite\"",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{projectRoot}/output/events.sqlite"]
    },
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "preview": {
      "configurations": {
        "ingested": {}
      },
      "dependsOn": ["build"],
      "description": "Serve the production build locally",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "{projectRoot}"
      }
    },
    "spell-check": {},
    "start": {
      "configurations": {
        "ingested": {}
      },
      "dependsOn": ["build-database"],
      "description": "Start the development server with hot reload",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite dev",
        "cwd": "{projectRoot}"
      }
    },
    "stop": {
      "options": {
        "port": 8967
      }
    },
    "stylelint": {},
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
