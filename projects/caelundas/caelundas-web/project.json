{
  "name": "caelundas-web",
  "namedInputs": {
    "default": [
      "!{projectRoot}/.cspell/**",
      "!{projectRoot}/.eslintcache/**",
      "!{projectRoot}/conformetry-templates/**",
      "!{projectRoot}/cspell.config.yaml",
      "{projectRoot}/**/*",
      "shared-globals"
    ]
  },
  "projectType": "application",
  "sourceRoot": "projects/caelundas/caelundas-web/src",
  "tags": [
    "domain:caelundas",
    "framework:react",
    "framework:tanstack-start",
    "generator:tanstack-application",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "build": {
      "description": "Build the application for production",
      "executor": "nx:run-commands",
      "inputs": ["^production", "dependency-versions", "production"],
      "options": {
        "command": "vite build --config configuration/vite.config.mts",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "codegen": {
      "configurations": {
        "check": {
          "command": "pnpm run codegen --check"
        }
      },
      "description": "Generate typed GraphQL operations and test mocks",
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/configuration/codegen.ts",
        "{projectRoot}/src/graphql/operations/**/*.graphql",
        "{workspaceRoot}/projects/caelundas/caelundas-api/src/schema.gql"
      ],
      "options": {
        "command": "pnpm run codegen",
        "cwd": "{projectRoot}"
      },
      "outputs": [
        "{projectRoot}/src/graphql/generated/mocks.ts",
        "{projectRoot}/src/graphql/generated/operations.ts"
      ]
    },
    "codegen-watch": {
      "continuous": true,
      "dependsOn": ["caelundas-api:await-health", "caelundas-api:start"],
      "description": "Regenerate GraphQL artifacts when schema or operations change",
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run codegen:watch",
        "cwd": "{projectRoot}"
      }
    },
    "dependency-cruiser": {},
    "deprecate-code": {},
    "docker": {
      "cache": false,
      "configurations": {
        "build": {
          "command": "docker compose -f infrastructure/docker/docker-compose.images.yml build caelundas-web"
        },
        "push": {
          "command": "docker compose -f infrastructure/docker/docker-compose.images.yml build --push caelundas-web"
        }
      },
      "defaultConfiguration": "build",
      "description": "Build (`docker:build`, loaded into the local daemon) or build and push (`docker:push`, one `docker compose build --push`) the caelundas-web image for linux/amd64 with the `caelundas-web` service of infrastructure/docker/docker-compose.images.yml, tagged ghcr.io/organizzolini/caelundas-web:$IMAGE_TAG (default local). It bakes VITE_CAELUNDAS_API_URL into the app. Set IMAGE_CA_BUNDLE to a PEM file to trust a TLS-inspecting proxy during the build. Never cached: a Docker build has no file outputs Nx could restore, so a remote cache hit would skip building, and a push is a side effect; layer caching is BuildKit's job.",
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "eslint": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "preview": {
      "dependsOn": ["build"],
      "description": "Serve the production build locally",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview --config configuration/vite.config.mts",
        "cwd": "{projectRoot}"
      }
    },
    "spell-check": {},
    "start": {
      "description": "Start the development server with hot reload",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite dev --config configuration/vite.config.mts",
        "cwd": "{projectRoot}"
      }
    },
    "stop": {
      "options": {
        "port": 8967
      }
    },
    "stylelint": {},
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "vitest": {},
    "yaml-lint": {}
  }
}
