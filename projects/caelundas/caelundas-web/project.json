{
  "name": "caelundas-web",
  "namedInputs": {
    "default": [
      "!{projectRoot}/.cspell/**",
      "!{projectRoot}/.eslintcache/**",
      "!{projectRoot}/conformetry-templates/**",
      "!{projectRoot}/cspell.config.yaml",
      "{projectRoot}/**/*",
      "{workspaceRoot}/projects/caelundas/caelundas-cli/data/*.sql",
      "{workspaceRoot}/projects/caelundas/caelundas-entities/src/modules/database/migrations/*.sql",
      "shared-globals"
    ]
  },
  "projectType": "application",
  "sourceRoot": "projects/caelundas/caelundas-web/src",
  "tags": [
    "domain:caelundas",
    "framework:react",
    "framework:tanstack-start",
    "generator:tanstack-application",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "build": {
      "configurations": {
        "ingested": {}
      },
      "dependsOn": ["build-database"],
      "description": "Build the application for production",
      "executor": "nx:run-commands",
      "inputs": [
        "^production",
        "dependency-versions",
        "production",
        {
          "dependentTasksOutputFiles": "**/events.sqlite"
        }
      ],
      "options": {
        "command": "vite build",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "build-database": {
      "cache": false,
      "configurations": {
        "ingested": {
          "command": "node scripts/build-events-database.ts --ingested"
        }
      },
      "description": "Write the SQLite file the static build bundles into output/, from caelundas-entities' migration and caelundas-cli's committed seed rows, or with the ingested configuration by copying the output/database.sqlite a caelundas-cli run wrote",
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/build-events-database.ts",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/output/events.sqlite"]
    },
    "codegen": {
      "configurations": {
        "check": {
          "command": "pnpm run codegen --check"
        }
      },
      "description": "Generate typed GraphQL operations and test mocks",
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/codegen.ts",
        "{projectRoot}/src/graphql/operations/**/*.graphql",
        "{workspaceRoot}/projects/caelundas/caelundas-api/src/schema.gql"
      ],
      "options": {
        "command": "pnpm run codegen",
        "cwd": "{projectRoot}"
      },
      "outputs": [
        "{projectRoot}/src/graphql/generated/mocks.ts",
        "{projectRoot}/src/graphql/generated/operations.ts"
      ]
    },
    "codegen-watch": {
      "continuous": true,
      "dependsOn": ["caelundas-api:await-health", "caelundas-api:start"],
      "description": "Regenerate GraphQL artifacts when schema or operations change",
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run codegen:watch",
        "cwd": "{projectRoot}"
      }
    },
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "preview": {
      "configurations": {
        "ingested": {}
      },
      "dependsOn": ["build"],
      "description": "Serve the production build locally",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "{projectRoot}"
      }
    },
    "spell-check": {},
    "start": {
      "configurations": {
        "ingested": {}
      },
      "dependsOn": ["build-database"],
      "description": "Start the development server with hot reload",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite dev",
        "cwd": "{projectRoot}"
      }
    },
    "stop": {
      "options": {
        "port": 8967
      }
    },
    "stylelint": {},
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
