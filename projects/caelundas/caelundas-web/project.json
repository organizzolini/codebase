{
  "name": "caelundas-web",
  "namedInputs": {
    "default": [
      "!{projectRoot}/.cspell/**",
      "!{projectRoot}/.eslintcache/**",
      "!{projectRoot}/conformetry-templates/**",
      "!{projectRoot}/cspell.config.yaml",
      "{projectRoot}/**/*",
      "shared-globals"
    ]
  },
  "projectType": "application",
  "sourceRoot": "projects/caelundas/caelundas-web/src",
  "tags": [
    "domain:caelundas",
    "framework:react",
    "framework:tanstack-start",
    "generator:tanstack-application",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "build": {
      "description": "Build the application for production",
      "executor": "nx:run-commands",
      "inputs": ["^production", "dependency-versions", "production"],
      "options": {
        "command": "vite build --config configuration/vite.config.mts",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "codegen": {
      "configurations": {
        "check": {
          "command": "pnpm run codegen --check"
        }
      },
      "description": "Generate typed GraphQL operations and test mocks",
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/configuration/codegen.ts",
        "{projectRoot}/src/graphql/operations/**/*.graphql",
        "{workspaceRoot}/projects/caelundas/caelundas-api/src/schema.gql"
      ],
      "options": {
        "command": "pnpm run codegen",
        "cwd": "{projectRoot}"
      },
      "outputs": [
        "{projectRoot}/src/graphql/generated/mocks.ts",
        "{projectRoot}/src/graphql/generated/operations.ts"
      ]
    },
    "codegen-watch": {
      "continuous": true,
      "dependsOn": ["caelundas-api:await-health", "caelundas-api:start"],
      "description": "Regenerate GraphQL artifacts when schema or operations change",
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run codegen:watch",
        "cwd": "{projectRoot}"
      }
    },
    "dependency-cruiser": {},
    "deprecate-code": {},
    "docker-build": {
      "cache": false,
      "description": "Build the caelundas-web production image for linux/amd64 from the workspace root, tagged with IMAGE_TAG (default local) and baking VITE_CAELUNDAS_API_URL into the app; set CAELUNDAS_API_IMAGE_CA_BUNDLE to a PEM file to trust a TLS-inspecting proxy during the build",
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build --platform linux/amd64 -f projects/caelundas/caelundas-web/configuration/Dockerfile${CAELUNDAS_API_IMAGE_CA_BUNDLE:+ --secret id=ca-bundle,src=$CAELUNDAS_API_IMAGE_CA_BUNDLE}${VITE_CAELUNDAS_API_URL:+ --build-arg \"VITE_CAELUNDAS_API_URL=$VITE_CAELUNDAS_API_URL\"} -t ghcr.io/organizzolini/caelundas-web:${IMAGE_TAG:-local} .",
        "cwd": "{workspaceRoot}"
      }
    },
    "docker-push": {
      "cache": false,
      "description": "Push the caelundas-web image tagged with IMAGE_TAG (default local) to GHCR",
      "executor": "nx:run-commands",
      "options": {
        "command": "docker push ghcr.io/organizzolini/caelundas-web:${IMAGE_TAG:-local}",
        "cwd": "{workspaceRoot}"
      }
    },
    "eslint": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "preview": {
      "dependsOn": ["build"],
      "description": "Serve the production build locally",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview --config configuration/vite.config.mts",
        "cwd": "{projectRoot}"
      }
    },
    "spell-check": {},
    "start": {
      "description": "Start the development server with hot reload",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite dev --config configuration/vite.config.mts",
        "cwd": "{projectRoot}"
      }
    },
    "stop": {
      "options": {
        "port": 8967
      }
    },
    "stylelint": {},
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "vitest": {},
    "yaml-lint": {}
  }
}
