{
  "name": "caelundas-web",
  "projectType": "application",
  "sourceRoot": "projects/caelundas/caelundas-web/src",
  "tags": [
    "domain:caelundas",
    "framework:react",
    "framework:tanstack-start",
    "generator:tanstack-application",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "build": {
      "configurations": {
        "export": {}
      },
      "dependsOn": ["build-database"],
      "description": "Build the application for production",
      "executor": "nx:run-commands",
      "inputs": [
        "^production",
        "dependency-versions",
        "production",
        {
          "dependentTasksOutputFiles": "**/events.sqlite"
        }
      ],
      "options": {
        "command": "vite build",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "build-database": {
      "cache": false,
      "configurations": {
        "export": {
          "command": "node scripts/build-events-database.ts --export"
        }
      },
      "description": "Write the SQLite file the static build bundles into output/, from the committed seed, or with the export configuration from the Postgres tables caelundas-cli ingested into",
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/build-events-database.ts",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/output/events.sqlite"]
    },
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "preview": {
      "configurations": {
        "export": {}
      },
      "dependsOn": ["build"],
      "description": "Serve the production build locally",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "{projectRoot}"
      }
    },
    "spell-check": {},
    "start": {
      "configurations": {
        "export": {}
      },
      "dependsOn": ["build-database"],
      "description": "Start the development server with hot reload",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite dev",
        "cwd": "{projectRoot}"
      }
    },
    "stop": {
      "options": {
        "port": 8967
      }
    },
    "stylelint": {},
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
