{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022", "ES2023.Array"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["../../common/presentation/src/*"],
      "@codebase/presentation": ["../../common/presentation/src/index.ts"]
    },
    "target": "ES2022",
    "types": ["node", "vite/client"]
  },
  "exclude": ["dist", "node_modules", "output"],
  "extends": "@codebase/configuration/tsconfig.json",
  "include": [
    "callidescope.config.ts",
    "codometer.config.ts",
    "eslint.config.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "testing/**/*.ts",
    "testing/**/*.tsx",
    "vite.config.mts",
    "vitest.config.ts"
  ]
}
