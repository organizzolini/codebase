  "name": "installation",
  "projectType": "application",
  "sourceRoot": "projects/installation",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "type:package"
  ],
  "targets": {
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
