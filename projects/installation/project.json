{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "installation",
  "projectType": "application",
  "sourceRoot": "projects/installation",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "type:package"
  ],
  "targets": {
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "repl": {},
    "spell-check": {},
    "start": {
      "cache": false,
      "configurations": {
        "dependencies": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register projects/installation/src/main.ts dependencies"
        },
        "environment-files": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register projects/installation/src/main.ts environment-files"
        },
        "setup": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register projects/installation/src/main.ts setup"
        },
        "shell-configuration": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register projects/installation/src/main.ts shell-configuration"
        },
        "software": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register projects/installation/src/main.ts software"
        }
      },
      "description": "Run one setup command by name: setup, shell-configuration, software, environment-files, or dependencies.",
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register projects/installation/src/main.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
