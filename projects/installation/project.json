    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "repl": {},
    "spell-check": {},
    "start": {
      "cache": false,
      "description": "Run the post-Node developer-machine setup, or one of its steps by name.",
      "executor": "nx:run-commands",
