{
  "dependencies": {
    "@codebase/presentation": "workspace:*",
    "@graphql-codegen/cli": "catalog:",
    "@graphql-typed-document-node/core": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-start": "catalog:",
    "graphql": "catalog:",
    "lodash": "catalog:",
    "lucide-react": "catalog:",
    "msw": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@graphql-codegen/typed-document-node": "catalog:",
    "@graphql-codegen/typescript": "catalog:",
    "@graphql-codegen/typescript-msw": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "autoprefixer": "catalog:",
    "graphql-codegen-typescript-validation-schema": "catalog:",
    "jsdom": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "name": "lexico-web",
  "private": true,
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch"
  },
  "type": "module",
  "typeCoverage": {
    "atLeast": 100,
    "ignoreCatch": true,
    "ignoreFiles": [
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/routeTree.gen.ts",
      "src/graphql/generated/**",
      "src/router.tsx",
      "src/routeTree.gen.ts",
      "testing/**",
      "testing/render-route.tsx"
    ],
    "strict": true
  },
  "version": "0.0.1"
}
