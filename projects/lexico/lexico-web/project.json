{
  "implicitDependencies": ["components"],
  "name": "lexico-web",
  "projectType": "application",
  "sourceRoot": "projects/lexico/lexico-web/src",
  "tags": [
    "domain:lexico",
    "framework:react",
    "framework:tanstack-start",
    "generator:tanstack-application",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "build": {
      "description": "Build the application for production",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "build-projects": {},
    "codegen": {
      "description": "Generate typed GraphQL operations, runtime schemas, and test mocks",
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/codegen.ts",
        "{projectRoot}/src/graphql/operations/**/*.graphql",
        "{workspaceRoot}/projects/lexico/lexico-api/src/schema.gql"
      ],
      "options": {
        "command": "pnpm run codegen",
        "cwd": "{projectRoot}"
      },
      "outputs": [
        "{projectRoot}/src/graphql/generated/mocks.ts",
        "{projectRoot}/src/graphql/generated/operations.ts",
        "{projectRoot}/src/graphql/generated/validation.ts"
      ]
    },
    "codegen-watch": {
      "continuous": true,
      "dependsOn": ["lexico-api:await-health", "lexico-api:start"],
      "description": "Regenerate GraphQL artifacts when schema or operations change",
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run codegen:watch",
        "cwd": "{projectRoot}"
      }
    },
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "preview": {
      "dependsOn": ["build"],
      "description": "Serve the production build locally",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "{projectRoot}"
      }
    },
    "spell-check": {},
    "start": {
      "continuous": true,
      "dependsOn": ["lexico-api:await-health", "lexico-api:start"],
      "description": "Start the development server with hot reload",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite dev",
        "cwd": "{projectRoot}"
      }
    },
    "stop": {
      "options": {
        "port": 7797
      }
    },
    "stylelint": {},
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
