{
  "implicitDependencies": ["components"],
  "name": "lexico-web",
  "projectType": "application",
  "sourceRoot": "projects/lexico/lexico-web/src",
  "tags": [
    "domain:lexico",
    "framework:react",
    "framework:tanstack-start",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "build": {
      "description": "Build the application for production",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build",
        "cwd": "projects/lexico/lexico-web"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "build-projects": {},
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "preview": {
      "dependsOn": ["build"],
      "description": "Build, then serve the production build",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "{projectRoot}"
      }
    },
    "spell-check": {},
    "start": {
      "continuous": true,
      "dependsOn": ["lexico-api:await-health", "lexico-api:start"],
      "description": "Start development server with hot reload, once the API is ready",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite dev",
        "cwd": "projects/lexico/lexico-web"
      }
    },
    "stop": {
      "options": {
        "port": 7797
      }
    },
    "stylelint": {},
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
