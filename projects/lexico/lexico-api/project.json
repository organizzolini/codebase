{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "lexico-api",
  "projectType": "application",
  "sourceRoot": "projects/lexico/lexico-api",
  "tags": [
    "domain:lexico",
    "framework:nestjs",
    "generator:nestjs-graphql-application",
    "language:graphql",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "await-health": {
      "options": {
        "url": "http://localhost:${LEXICO_API_PORT:-8398}/graphql"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": [
          {
            "glob": "README.md",
            "input": "projects/lexico/lexico-api",
            "output": "."
          }
        ],
        "generatePackageJson": false,
        "main": "projects/lexico/lexico-api/src/lexico-api.ts",
        "outputPath": "projects/lexico/lexico-api/dist",
        "tsConfig": "projects/lexico/lexico-api/tsconfig.build.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "develop": {
      "continuous": true,
      "description": "Start the LexicoApi GraphQL API with restart on change",
      "executor": "nx:run-commands",
      "options": {
        "command": "node --watch --import @swc-node/register/esm-register src/lexico-api.ts",
        "cwd": "{projectRoot}"
      }
    },
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "spell-check": {},
    "start": {
      "description": "Start the LexicoApi GraphQL API",
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register src/lexico-api.ts",
        "cwd": "{projectRoot}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
