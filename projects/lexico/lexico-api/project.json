{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "lexico-api",
  "projectType": "application",
  "sourceRoot": "projects/lexico/lexico-api",
  "tags": [
    "domain:lexico",
    "framework:nestjs",
    "generator:nestjs-graphql-application",
    "language:graphql",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": [
          {
            "glob": "README.md",
            "input": "projects/lexico/lexico-api",
            "output": "."
          }
        ],
        "generatePackageJson": false,
        "main": "projects/lexico/lexico-api/src/lexico-api.ts",
        "outputPath": "projects/lexico/lexico-api/dist",
        "tsConfig": "projects/lexico/lexico-api/tsconfig.build.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "develop": {
      "continuous": true,
      "description": "Start the LexicoApi GraphQL API with restart on change",
      "executor": "nx:run-commands",
      "options": {
        "command": "node --watch --import @swc-node/register/esm-register src/lexico-api.ts",
        "cwd": "{projectRoot}"
      }
    },
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "spell-check": {},
    "start": {
      "description": "Start the LexicoApi GraphQL API",
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register src/lexico-api.ts",
        "cwd": "{projectRoot}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "wait-ready": {
      "cache": false,
      "dependsOn": ["develop"],
      "description": "Block until the running LexicoApi answers its GraphQL health query with true",
      "executor": "nx:run-commands",
      "options": {
        "command": "end=$(( $(date +%s) + 60 )); while [ \"$(date +%s)\" -lt \"$end\" ]; do curl -fsS -m 2 -H \"content-type: application/json\" -d '{\"query\":\"{ health }\"}' \"http://localhost:${LEXICO_API_PORT:-8398}/graphql\" 2>/dev/null | grep -q '\"health\":true' && exit 0; sleep 0.5; done; echo \"LexicoApi was not healthy after 60s\" >&2; exit 1"
      }
    },
    "yaml-lint": {}
  }
}
