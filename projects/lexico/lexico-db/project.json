{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "lexico-db",
  "projectType": "library",
  "sourceRoot": "projects/lexico/lexico-db",
  "tags": [
    "domain:lexico",
    "framework:nestjs",
    "framework:typeorm",
    "generator:nestjs-database-project",
    "language:typescript",
    "name:lexico-db",
    "type:package"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "assets": [
          {
            "glob": "README.md",
            "input": "projects/lexico/lexico-db",
            "output": "."
          }
        ],
        "generatePackageJson": false,
        "main": "projects/lexico/lexico-db/src/index.ts",
        "outputPath": "projects/lexico/lexico-db/dist",
        "tsConfig": "projects/lexico/lexico-db/configuration/tsconfig.build.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "build-projects": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "erd": {
      "configurations": {
        "check": {
          "command": "SWC_NODE_PROJECT=../../../projects/common/persistence/configuration/tsconfig.json node --import @swc-node/register/esm-register ../../../projects/common/persistence/src/persistence.main.ts postgresql-erd --entities \"src/**/*.entity.ts\" --output-markdown documentation/erd.md --check"
        },
        "write": {
          "command": "SWC_NODE_PROJECT=../../../projects/common/persistence/configuration/tsconfig.json node --import @swc-node/register/esm-register ../../../projects/common/persistence/src/persistence.main.ts postgresql-erd --entities \"src/**/*.entity.ts\" --output-markdown documentation/erd.md"
        }
      },
      "defaultConfiguration": "check",
      "description": "Check or write the project ERD from its TypeORM entity files",
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/documentation/erd.md"]
    },
    "eslint": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "migration": {
      "options": {
        "module": "src/modules/database"
      }
    },
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "spell-check": {},
    "sqlfluff-format": {},
    "sqlfluff-lint": {},
    "squawk": {},
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "vitest": {},
    "yaml-lint": {}
  }
}
