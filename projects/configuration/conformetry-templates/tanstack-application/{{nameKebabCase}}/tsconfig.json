{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "codebase/configuration/*": ["{{workspaceRelativePrefix}}projects/configuration/*"],
      "eslint-plugin-better-max-params": [
        "{{workspaceRelativePrefix}}projects/configuration/types/eslint-plugin-better-max-params/index.d.ts"
      ]
    },
    "target": "ES2022",
    "types": ["node", "vite/client"]
  },
  "exclude": ["dist", "node_modules", "output"],
  "extends": "{{workspaceRelativePrefix}}projects/configuration/tsconfig.json",
  "include": [
    "callidescope.config.ts",
    "codometer.config.ts",
    "eslint.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "testing/**/*.ts",
    "testing/**/*.tsx",
    "vite.config.mts",
    "vitest.config.ts"
  ]
}
