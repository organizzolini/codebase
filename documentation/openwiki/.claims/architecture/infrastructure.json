    {
      "id": "claim_ca69ae54f21b4b4085cee212c0cdb03c",
      "statement": "The PostgreSQL Compose service uses a Compose config (postgres-databases) that installs an executable init script at /docker-entrypoint-initdb.d/databases.sh, which runs only on an empty volume and creates a role, database, and schema for each project listed in POSTGRES_PROJECTS (currently caelundas, lexico, meanderaw).",
      "evidence": [
        {
          "resource": "repo://infrastructure/README.md#L55-L80",
          "version": "repo-lines-v1:sha256:4e9921c955905f44a3bf0c094b0c9c54e4473559f1badb52a50723eb2f584c2b:"
