    {
      "id": "claim_dd0ef5967e46494b9da91300cb00705c",
      "statement": "To add a project to an existing PostgreSQL volume without data loss, add the project to POSTGRES_PROJECTS, run nx run infrastructure:postgres:up to recreate the container keeping the volume, then execute the init script for only the missing project via docker exec -e POSTGRES_PROJECTS=<project> postgres sh /docker-entrypoint-initdb.d/databases.sh.",
