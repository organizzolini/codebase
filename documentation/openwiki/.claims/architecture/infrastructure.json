    {
      "id": "claim_f8fdf06d19284edc901380f7c989c7bd",
      "statement": "The kubernetes-job chart's PVC is conditionally created (when persistence.enabled=true), named after the Job via the kubernetes-job.fullname helper, uses storageClassName standard by default with 1Gi size and ReadWriteOnce access, mounts at /app/output, and is never automatically deleted when the Job completes — it must be manually removed with kubectl delete pvc.",
