  "claims": [
    {
      "id": "claim_555d9e10539441148d9d2a93bab1f470",
      "statement": "The persistence package enforces a database/schema/role naming convention where local Docker uses <project>_development database with <project> schema and <project>_username role, while Testcontainers uses <project>_testing database with the same schema and role; the schema carries no environment suffix so migrations apply unchanged.",
      "evidence": [
        {
          "resource": "repo://projects/common/persistence/README.md#L12-L18",
          "version": "repo-lines-v1:sha256:ec8a6728bfb3853ca21d30cef73080254c6941a27fd197857bf62b3e0353b359:"
        }
      ]
    },
    {
      "id": "claim_1210d54daf71447c84e4b8a9ea606442",
      "statement": "Applications consume persistence by spreading postgresEnvironmentSchema into their Zod environment schema with a project name, creating a database module that imports PostgresqlModule.forRoot with entities and project name, and exporting a CLI DataSource via createDataSource with migrations.",
      "evidence": [
        {
          "resource": "repo://projects/common/persistence/README.md#L39-L103",
          "version": "repo-lines-v1:sha256:c98c0dae3e4189300b7f909c6776a54e7a7e3c43a47dcccc823ae94076245e5c:"
        }
      ]
    },
    {
      "id": "claim_665bb5373d624025a71e9a2d5c76748b",
      "statement": "The persistence package never synchronizes or runs migrations on application start; synchronize and migrationsRun are both false, and migrations run only via the migration Nx target as a separate step.",
