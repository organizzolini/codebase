    {
      "id": "claim_a5504941fb7a436cb0d83f450f3d812a",
      "statement": "A Code is the direction bits that are a meander: one hexadecimal digit per interior lattice point of one true repeat, read row-major, worth 8 north, 4 south, 2 east, 1 west. A meander is its Code — nothing else identifies it.",
      "evidence": [
        {
          "resource": "repo://CONTEXT.md#L92-L97",
          "version": "repo-lines-v1:sha256:d45d7c246316cffc75cc3b05ea031980a69606dad7a143a0956e660f0ab14832:"
        }
      ]
    },
    {
      "id": "claim_3ce97775a46a41ed9b3353c9b3979501",
      "statement": "The Code format uses 4-bit direction encoding per lattice point: bit 8=North, 4=South, 2=East, 1=West, read row-major at index row * columns + column.",
      "evidence": [
        {
          "resource": "repo://projects/meanderaw/meanderaw-cli/src/modules/code/code.service.ts#L181-L191",
          "version": "repo-lines-v1:sha256:2319eb98237a5ebb279f419f03e5401ae7dc5e8259fdbcd0c3bf612f3fdf87ec:"
