        }
      ]
    },
    {
      "id": "claim_b938d1fb80a34a549180bcb8ad9cafca",
      "statement": "Each project reads only its own `<PROJECT>_POSTGRES_*` variables (`_HOST`, `_PORT`, `_USERNAME`, `_PASSWORD`, `_DATABASE`, `_SCHEMA`); the root `.env` holds unprefixed `POSTGRES_DB`, `POSTGRES_USER`, `POSTGRES_PASSWORD` for the shared container's admin login which applications never read.",
