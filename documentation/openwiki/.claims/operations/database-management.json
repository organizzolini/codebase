    {
      "id": "claim_928df551757e48d99136766a4b090942",
      "statement": "Every database-backed project owns its own database, schema, and role following the naming convention: local Docker uses `<project>_development` database, `<project>` schema, and `<project>_username`/`<project>_password` role; Testcontainers uses `<project>_testing` database with same schema and role; Kubernetes will use `<project>_staging`/`<project>_production` databases with same schema.",
      "evidence": [
        {
          "resource": "repo://documentation/adr/0022-give-every-database-project-its-own-database-schema-and-role.md#L17-L23",
          "version": "repo-lines-v1:sha256:5a6101fc42dee324579f2253cefe49acdff45258bffbd47ce0af6b2eaa9c3837:"
        },
