        }
      ]
    },
    {
      "id": "claim_a487d5f7943a4e61970821ca978acb9c",
      "statement": "Codependix uses its own named anchor syntax (<!-- codependix:start name=\"...\" --> / <!-- codependix:end name=\"...\" -->) for splicing exports into Markdown, independent of conformetry's template mechanism.",
