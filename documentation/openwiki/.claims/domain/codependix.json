    {
      "id": "claim_317d0b40daca410fa45ea0c03f9391c7",
      "statement": "Anchor renaming requires a two-place coordinated commit: rename in projectDefaults and re-splice every file carrying the blocks in the same commit; a half-done rename leaves orphaned blocks that fail markdown-lint in the version commit's prepare hook, blocking the release.",
