    {
      "id": "claim_2af84c1fb18745d684ebfd100bc2a746",
      "statement": "Boundary rules are declared in codependix.config.ts under boundaries keyed by graph level, with three rule kinds: allow (reports edges leaving 'from' for targets not in 'to'), forbid (reports edges from 'from' to 'to'), and acyclic (reports cycles where all nodes match the selector).",
      "evidence": [
        {
          "resource": "repo://configuration/codependix.config.ts#L172-L202",
          "version": "repo-lines-v1:sha256:e62bd5348c1affb584db7222159448bb1d96e58c756fe8cb3ac3a132b171afd5:"
