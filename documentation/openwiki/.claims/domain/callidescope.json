    {
      "id": "claim_a660b607afe04249ba848bf8928152bf",
      "statement": "Callidescope defines five core concepts with precise vocabulary: Callable (function-like declaration traced by file and byte offset), Stack (entry point plus deepest path, reporting a floor when the path runs through an unresolved call), Depth (frames on a stack, entry point inclusive, one of two gated limits), Breadth (distinct direct callees, the other gated limit), and Entry Point (a callable rooting a stack; declared is the only kind a person chose).",
      "evidence": [
        {
          "resource": "repo://projects/ic-suite/callidescope/callidescope-cli/README.md#L1-L12",
          "version": "repo-lines-v1:sha256:5905bc75ae3c495834cfdf2edd07eb1f7a34bf9f221788b5c4accd30a6da3b29:"
