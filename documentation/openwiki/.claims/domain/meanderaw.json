    {
      "id": "claim_d5261d6e0f2445ac9c5f2656a93b46c8",
      "statement": "Meanderaw is a NestJS CLI application that enumerates Greek key/fret patterns into Postgres by lattice address (Code), measures structural Characteristics, classifies compound pattern booleans, and streams HTML index pages to a gitignored output directory.",
