{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/git/validate-subagent-model.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Agent"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/git/validate-session-branch-name.sh\"",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/git/validate-session-worktree-name.sh\"",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/git/validate-session-commit-signing.sh\"",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/git/validate-session-gh-authentication.sh\"",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/git/validate-session-skills.sh\"",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/git/validate-session-hooks-path.sh\"",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ]
  },
  "remoteControlAtStartup": true
}
