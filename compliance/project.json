{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "compliance",
  "sourceRoot": "compliance",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "dependency-cruiser": {},
    "deprecate-code": {},
    "eslint": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "pull-request-template": {
      "cache": true,
      "configurations": {
        "check": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register compliance/src/compliance.main.ts pull-request-template check"
        },
        "write": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register compliance/src/compliance.main.ts pull-request-template write"
        }
      },
      "defaultConfiguration": "check",
      "description": "Reconciles derived pull request template content. `check` runs on a pull request; `write` runs on the default branch's release. Reads only files in the repository, so it needs no token.",
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/**/*.ts",
        "{workspaceRoot}/.github/PULL_REQUEST_TEMPLATE.md",
        "{workspaceRoot}/configuration/repository/conventional.config.cjs",
        "shared-globals"
      ],
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "repl": {
      "cache": false,
      "configurations": {},
      "description": "Start a Nest Commander application in REPL mode",
      "executor": "nx:run-commands",
      "options": {
        "command": "SWC_NODE_PROJECT=configuration/tsconfig.json node --import @swc-node/register/esm-register src/compliance.repl.ts",
        "cwd": "compliance"
      },
      "parallelism": true
    },
    "spell-check": {},
    "start": {
      "cache": false,
      "configurations": {
        "audit-files": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register compliance/src/compliance.main.ts audit-files"
        },
        "issue": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register compliance/src/compliance.main.ts issue"
        },
        "issue-audit": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register compliance/src/compliance.main.ts issue --all"
        },
        "organization-project": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register compliance/src/compliance.main.ts organization-project"
        },
        "pull-request": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register compliance/src/compliance.main.ts pull-request"
        }
      },
      "description": "Run one compliance command by name.",
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register compliance/src/compliance.main.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "vitest": {},
    "yaml-lint": {}
  }
}
