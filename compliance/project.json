{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "compliance",
  "sourceRoot": "compliance",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "repl": {
      "cache": false,
      "configurations": {},
      "description": "Start a Nest Commander application in REPL mode",
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import @swc-node/register/esm-register src/compliance.repl.ts",
        "cwd": "compliance"
      },
      "parallelism": true
    },
    "spell-check": {},
    "start": {
      "cache": false,
      "configurations": {
        "audit-governance": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register compliance/src/compliance.main.ts audit-governance"
        },
        "issue": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register compliance/src/compliance.main.ts issue"
        },
        "issue-audit": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register compliance/src/compliance.main.ts issue --all"
        },
        "organization-project": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register compliance/src/compliance.main.ts organization-project"
        },
        "pull-request": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register compliance/src/compliance.main.ts pull-request"
        }
      },
      "description": "Run one compliance command by name.",
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register compliance/src/compliance.main.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
