{
  "compilerOptions": {
    // `configuration/lint-staged.config.ts` is loaded by Node's native
    // TypeScript stripping during pre-commit, which resolves imports exactly
    // as written and so needs explicit `.ts` extensions. Safe here because
    // this project only typechecks.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "codebase/configuration/*": ["./*"],
      "eslint-plugin-better-max-params": [
        "./types/eslint-plugin-better-max-params/index.d.ts"
      ]
    },
    "skipLibCheck": true
  },
  "exclude": [
    "../applications",
    "../dist",
    "../node_modules",
    "../packages",
    "./conformetry-templates",
    "../tmp",
    "../tools"
  ],
  "extends": "./tsconfig.json",
  "include": [
    "../*.ts",
    "../.devcontainer/scripts/**/*.ts",
    "./**/*.ts",
    "../scripts/**/*.ts"
  ]
}
