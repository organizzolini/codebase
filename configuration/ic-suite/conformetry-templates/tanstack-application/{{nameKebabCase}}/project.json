{
  "name": "{{nameKebabCase}}",
  "projectType": "application",
  "tags": [
    "framework:react",
    "framework:tanstack-start",
    "generator:tanstack-application",
    "language:typescript",
    "type:application"
  ],
  "targets": {
    "build": {
      "description": "Build the application for production",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --config configuration/vite.config.mts",
        "cwd": "{projectRoot}"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "dependency-cruiser": {},
    "deprecate-code": {},
    "eslint": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "preview": {
      "dependsOn": [
        "build"
      ],
      "description": "Serve the production build locally",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview --config configuration/vite.config.mts",
        "cwd": "{projectRoot}"
      }
    },
    "spell-check": {},
    "start": {
      "description": "Start the development server with hot reload",
      "executor": "nx:run-commands",
      "options": {
        "command": "vite dev --config configuration/vite.config.mts",
        "cwd": "{projectRoot}"
      }
    },
    "stylelint": {},
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "vitest": {},
    "yaml-lint": {}
  }
}
