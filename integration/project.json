{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "integration",
  "projectType": "application",
  "sourceRoot": "integration",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "type:package"
  ],
  "targets": {
    "build-projects": {},
    "codometer": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "format-code": {},
    "guard-code": {},
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "repl": {},
    "spell-check": {},
    "start": {
      "cache": false,
      "configurations": {
        "adopt-task-database": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register integration/src/integration.main.ts adopt-task-database"
        },
        "keep-task-database": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register integration/src/integration.main.ts keep-task-database"
        },
        "run-affected": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register integration/src/integration.main.ts run-affected"
        },
        "verify-task-database": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register integration/src/integration.main.ts verify-task-database"
        }
      },
      "description": "Run one integration command by name. Callers in CI set the variables each command reads, such as NX_BASE and NX_HEAD.",
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register integration/src/integration.main.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "yaml-lint": {}
  }
}
