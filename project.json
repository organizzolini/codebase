{
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "name": "codebase",
  "projectType": "application",
  "targets": {
    "conformetry-generate": {
      "cache": false,
      "description": "Run the conformetry generate command from the workspace root",
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx run conformetry-cli:start -- generate --config projects/configuration/conformetry.config.ts {args}",
        "cwd": "{workspaceRoot}"
      }
    },
    "format-code": {},
    "guard-code": {},
    "install-skills": {
      "cache": false,
      "configurations": {
        "force": {
          "command": "SKILLS_INSTALL_FORCE=1 bash scripts/install-skills.sh"
        }
      },
      "description": "Restore the skills listed in skills-lock.json from their source repositories into the gitignored .agents/skills/<name>/ folders. Also runs from postinstall; the force configuration re-restores skills that are already present.",
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/install-skills.sh",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint-code": {},
    "openwiki": {
      "cache": false,
      "configurations": {
        "write": {
          "commands": [
            "source .env",
            "pnpm exec openwiki code --update --print",
            "rm -f CLAUDE.md"
          ],
          "parallel": false
        }
      },
      "defaultConfiguration": "write",
      "description": "Update OpenWiki content from code using the OpenWiki CLI (prints changes).",
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "openwiki-update": {
      "cache": false,
      "description": "Update OpenWiki content from code using the OpenWiki CLI (prints changes).",
      "executor": "nx:run-commands",
      "options": {
        "command": "openwiki code --update --print",
        "cwd": "{workspaceRoot}"
      }
    },
    "postgres-data": {
      "configurations": {
        "dump-complete": {
          "command": "PGPASSWORD=${POSTGRES_PASSWORD:-postgres} pg_dump -h ${POSTGRES_HOST:-localhost} -p ${POSTGRES_PORT:-5432} -U ${POSTGRES_USER:-postgres} -Fc -d ${POSTGRES_DB:-postgres} -f data/complete.dump"
        },
        "dump-custom": {
          "command": "PGPASSWORD=${POSTGRES_PASSWORD:-postgres} pg_dump -h ${POSTGRES_HOST:-localhost} -p ${POSTGRES_PORT:-5432} -U ${POSTGRES_USER:-postgres} {args.flags} -Fc -d ${POSTGRES_DB:-postgres} -f data/{args.name}.dump"
        },
        "dump-database": {
          "command": "PGPASSWORD=${POSTGRES_PASSWORD:-postgres} pg_dump -h ${POSTGRES_HOST:-localhost} -p ${POSTGRES_PORT:-5432} -U ${POSTGRES_USER:-postgres} -Fc -d {args.database} -f data/{args.database}.dump"
        },
        "dump-dictionary": {
          "command": "PGPASSWORD=${POSTGRES_PASSWORD:-postgres} pg_dump -h ${POSTGRES_HOST:-localhost} -p ${POSTGRES_PORT:-5432} -U ${POSTGRES_USER:-postgres} -n lexico -t lexico.forms -t lexico.inflections -t lexico.lexemes -t lexico.principal_parts -t lexico.pronunciations -t lexico.translations -t lexico.words -t lexico.word_forms -t lexico.word_lexemes -Fc -d lexico_development -f data/dictionary.dump"
        },
        "dump-literature": {
          "command": "PGPASSWORD=${POSTGRES_PASSWORD:-postgres} pg_dump -h ${POSTGRES_HOST:-localhost} -p ${POSTGRES_PORT:-5432} -U ${POSTGRES_USER:-postgres} -n lexico -t lexico.authors -t lexico.lines -t lexico.texts -t lexico.tokens -Fc -d lexico_development -f data/literature.dump"
        },
        "dump-schema": {
          "command": "PGPASSWORD=${POSTGRES_PASSWORD:-postgres} pg_dump -h ${POSTGRES_HOST:-localhost} -p ${POSTGRES_PORT:-5432} -U ${POSTGRES_USER:-postgres} -n {args.schema} -Fc -d ${POSTGRES_DB:-postgres} -f data/{args.schema}.dump"
        },
        "dump-table": {
          "command": "PGPASSWORD=${POSTGRES_PASSWORD:-postgres} pg_dump -h ${POSTGRES_HOST:-localhost} -p ${POSTGRES_PORT:-5432} -U ${POSTGRES_USER:-postgres} -t {args.table} -Fc -d ${POSTGRES_DB:-postgres} -f data/{args.table}.dump"
        },
        "restore-complete": {
          "command": "PGPASSWORD=${POSTGRES_PASSWORD:-postgres} pg_restore -h ${POSTGRES_HOST:-localhost} -p ${POSTGRES_PORT:-5432} -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-postgres} -c -1 data/complete.dump"
        },
        "restore-custom": {
          "command": "PGPASSWORD=${POSTGRES_PASSWORD:-postgres} pg_restore -h ${POSTGRES_HOST:-localhost} -p ${POSTGRES_PORT:-5432} -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-postgres} -c -1 {args.flags} data/{args.name}.dump"
        },
        "restore-database": {
          "command": "PGPASSWORD=${POSTGRES_PASSWORD:-postgres} pg_restore -h ${POSTGRES_HOST:-localhost} -p ${POSTGRES_PORT:-5432} -U ${POSTGRES_USER:-postgres} -d {args.database} -c -1 data/{args.database}.dump"
        },
        "restore-dictionary": {
          "command": "PGPASSWORD=${POSTGRES_PASSWORD:-postgres} pg_restore -h ${POSTGRES_HOST:-localhost} -p ${POSTGRES_PORT:-5432} -U ${POSTGRES_USER:-postgres} -d lexico_development -c -1 -n lexico -t forms -t inflections -t lexemes -t principal_parts -t pronunciations -t translations -t words -t word_forms -t word_lexemes data/dictionary.dump"
        },
        "restore-literature": {
          "command": "PGPASSWORD=${POSTGRES_PASSWORD:-postgres} pg_restore -h ${POSTGRES_HOST:-localhost} -p ${POSTGRES_PORT:-5432} -U ${POSTGRES_USER:-postgres} -d lexico_development -c -1 -n lexico -t authors -t lines -t texts -t tokens data/literature.dump"
        },
        "restore-schema": {
          "command": "PGPASSWORD=${POSTGRES_PASSWORD:-postgres} pg_restore -h ${POSTGRES_HOST:-localhost} -p ${POSTGRES_PORT:-5432} -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-postgres} -c -1 -n {args.schema} data/{args.schema}.dump"
        },
        "restore-table": {
          "command": "PGPASSWORD=${POSTGRES_PASSWORD:-postgres} pg_restore -h ${POSTGRES_HOST:-localhost} -p ${POSTGRES_PORT:-5432} -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-postgres} -c -1 -t {args.table} data/{args.table}.dump"
        }
      },
      "description": "Dump and restore PostgreSQL data (databases, schemas, tables)",
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "secure-code-ci": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx affected --target=secure-code --parallel=4 && if [ \"$GITHUB_EVENT_NAME\" = \"schedule\" ] || [ \"$GITHUB_EVENT_NAME\" = \"workflow_dispatch\" ]; then pnpm exec nx run configuration:gitleaks:ci; else pnpm exec nx run configuration:gitleaks:ci-incremental; fi",
        "cwd": "{projectRoot}"
      }
    },
    "sqlfluff-format": {
      "cache": true,
      "configurations": {
        "check": {
          "args": "lint"
        },
        "write": {
          "args": "fix"
        }
      },
      "defaultConfiguration": "check",
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/notepads/*.sql",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock",
        "shared-globals",
        {
          "externalDependencies": []
        }
      ],
      "options": {
        "command": "uv run sqlfluff {args} --config pyproject.toml notepads",
        "cwd": "{workspaceRoot}"
      }
    },
    "sqlfluff-lint": {
      "cache": true,
      "configurations": {
        "check": {
          "args": "lint"
        },
        "write": {
          "args": "fix"
        }
      },
      "defaultConfiguration": "check",
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/notepads/*.sql",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock",
        "shared-globals",
        {
          "externalDependencies": []
        }
      ],
      "options": {
        "command": "uv run sqlfluff {args} --config pyproject.toml notepads",
        "cwd": "{workspaceRoot}"
      }
    },
    "type-coverage": {
      "cache": true,
      "description": "Check TypeScript type coverage for workspace root (minimum 95%)",
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/**/*.{ts,tsx}",
        "{workspaceRoot}/projects/configuration/**/*.{ts,tsx}",
        "{workspaceRoot}/tsconfig.json",
        "default",
        {
          "externalDependencies": ["type-coverage", "typescript"]
        }
      ],
      "options": {
        "command": "type-coverage --at-least 95 --detail --project tsconfig.json",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "cache": true,
      "description": "Type-check workspace root TypeScript files",
      "executor": "nx:run-commands",
      "inputs": [
        "^production",
        "{workspaceRoot}/*.ts",
        "{workspaceRoot}/.devcontainer/scripts/**/*.ts",
        "{workspaceRoot}/projects/configuration/**/*.ts",
        "{workspaceRoot}/scripts/**/*.ts",
        "{workspaceRoot}/tsconfig.json",
        "shared-globals",
        {
          "externalDependencies": ["typescript-7"]
        }
      ],
      "options": {
        "command": "node \"$NX_WORKSPACE_ROOT/node_modules/typescript-7/bin/tsc\" --noEmit -p tsconfig.json",
        "cwd": "{projectRoot}"
      },
      "outputs": []
    },
    "typecheck-code": {}
  }
}
