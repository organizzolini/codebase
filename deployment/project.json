{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "deployment",
  "projectType": "application",
  "sourceRoot": "deployment",
  "tags": [
    "framework:nest-commander",
    "framework:nestjs",
    "generator:nestjs-command-project",
    "language:typescript",
    "type:package"
  ],
  "targets": {
    "build-projects": {},
    "dependency-cruiser": {},
    "deprecate-code": {},
    "eslint": {},
    "format-code": {},
    "guard-code": {},
    "helm-lint": {
      "cache": true,
      "description": "Lint every Helm release this repository ships with `helm lint --strict`, each chart alone and layered with the values file each project owns. The `helm-lint` command of this project discovers the releases from the chart folders, as `helm-render` does, so lint and every render-based check judge the same set. Part of lint-code, so the Lint leg of continuous-integration.yml runs it. Requires helm on PATH (the devcontainer installs it; the GitHub-hosted runners ship it).",
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/src/**/*",
        "{workspaceRoot}/infrastructure/helm/**/*",
        "{workspaceRoot}/projects/**/infrastructure/helm/**/*",
        "{workspaceRoot}/projects/*/*/infrastructure/helm-values.yaml",
        {
          "externalDependencies": []
        }
      ],
      "options": {
        "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register deployment/src/deployment.main.ts helm-lint",
        "cwd": "{workspaceRoot}"
      }
    },
    "helm-render": {
      "cache": true,
      "description": "Render every Helm release to dist/deployment/helm-render/<release>.yaml with helm template, using the values file each project owns, which its Argo CD Application or workflow passes. The single rendering that kubeconform, kube-linter, pluto, and trivy-config all consume, so no tool re-templates differently. Requires helm on PATH.",
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/src/**/*",
        "{workspaceRoot}/infrastructure/helm/**/*",
        "{workspaceRoot}/projects/**/infrastructure/helm/**/*",
        "{workspaceRoot}/projects/*/*/infrastructure/helm-values.yaml",
        {
          "externalDependencies": []
        }
      ],
      "options": {
        "command": "rm -rf dist/deployment/helm-render && NODE_OPTIONS='' node --import @swc-node/register/esm-register deployment/src/deployment.main.ts helm-render --directory dist/deployment/helm-render",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/deployment/helm-render"]
    },
    "knip": {},
    "lint-code": {},
    "markdown-lint": {},
    "oxfmt": {},
    "oxlint": {},
    "prettier": {},
    "repl": {},
    "spell-check": {},
    "start": {
      "cache": false,
      "configurations": {
        "helm-lint": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register deployment/src/deployment.main.ts helm-lint"
        },
        "helm-render": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register deployment/src/deployment.main.ts helm-render"
        },
        "image-tags": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register deployment/src/deployment.main.ts image-tags"
        },
        "link-packages": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register deployment/src/deployment.main.ts link-packages"
        },
        "publish-packages": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register deployment/src/deployment.main.ts publish-packages"
        },
        "tag-codebase": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register deployment/src/deployment.main.ts tag-codebase"
        },
        "tag-packages": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register deployment/src/deployment.main.ts tag-packages"
        },
        "version-packages": {
          "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register deployment/src/deployment.main.ts version-packages"
        }
      },
      "description": "Run one deployment command by name. Callers in CI set the variables each command reads, such as NX_BASE and NX_HEAD.",
      "executor": "nx:run-commands",
      "options": {
        "command": "NODE_OPTIONS='' node --import @swc-node/register/esm-register deployment/src/deployment.main.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "test-code": {},
    "type-coverage": {},
    "typecheck": {},
    "typecheck-code": {},
    "vitest": {},
    "yaml-lint": {}
  }
}
